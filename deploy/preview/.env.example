# 本地沙箱示例（CONTRIBUTING §12：真实值不入仓；本目录本来也不需要口令）
# 镜像台账：PREVIEW_CONVERTER_TAG 与 PREVIEW_PIPELINE_VERSION 必须同值 ——
# 「换镜像 = 递增该值」，规则与原因见 README「镜像标签 ↔ PREVIEW_PIPELINE_VERSION」
PREVIEW_CONVERTER_IMAGE=libiaolink/preview-converter
PREVIEW_CONVERTER_TAG=1.0.0
PREVIEW_PIPELINE_VERSION=1.0.0

# 只发布到本机回环；worker 侧用 PREVIEW_CONVERTER_URL=http://127.0.0.1:9900 指向
PREVIEW_CONVERTER_PORT=9900

# 转换限额（沙箱默认；生产按 ADR-013 的 converter 限额 2C4G / 并发 2~4 调整）
PREVIEW_CONVERT_TIMEOUT_MS=60000
PREVIEW_CONVERT_MAX_BYTES=268435456
PREVIEW_CONVERT_MAX_CONCURRENCY=2
PREVIEW_CONVERT_MAX_QUEUE=8
PREVIEW_CONVERTER_MEM_LIMIT=2g
PREVIEW_CONVERTER_CPUS=2
PREVIEW_CONVERTER_TMPFS=1g
PREVIEW_CONVERTER_PIDS=512
