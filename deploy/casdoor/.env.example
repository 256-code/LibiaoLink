# 复制为 .env 后修改。注意：.env 含密码，务必加入 .gitignore，不要提交。
# Casdoor 镜像版本（对应 GitHub Release / Docker Hub tag）
CASDOOR_VERSION=4.4.0

# 对外完整地址（带协议），必须和访问地址、HTTPS 证书、Nginx server_name 一致。
# 本地联调改成 http://localhost:8000；自建生产改成你的正式域名。
SSO_ORIGIN=https://auth.libiaorobot.com

# 数据库密码
MYSQL_ROOT_PASSWORD=CHANGE_ME_root_pwd
MYSQL_PASSWORD=CHANGE_ME_casdoor_pwd

# Redis 密码（多副本部署必须接 Redis）
REDIS_PASSWORD=CHANGE_ME_redis_pwd
