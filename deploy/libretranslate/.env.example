# ============================================================
# LibiaoLink LibreTranslate 环境变量样例（cp .env.example .env 后按需改）
# ------------------------------------------------------------
# 镜像：Docker Hub 直连被墙时先经国内镜像源拉取再打回官方名，例如：
#   docker pull docker.m.daocloud.io/libretranslate/libretranslate:latest
#   docker tag docker.m.daocloud.io/libretranslate/libretranslate:latest libretranslate/libretranslate:latest
# ============================================================

# 镜像名（默认本地已打回的官方名；钉版本时写 libretranslate/libretranslate:<tag>）
LT_IMAGE=libretranslate/libretranslate:latest

# 监听地址与端口（默认只发回环；需要局域网联调时改 LT_BIND_IP=0.0.0.0）
LT_BIND_IP=127.0.0.1
LT_PORT=5005

# 只装中英两个语向（省内存；改这里需清空 data/argos 重新预置）
LT_LOAD_ONLY=zh,en

# gunicorn worker 数（每个 worker 首次翻译时各自加载模型；导出场景 2 个足够）
LT_THREADS=2

# 资源上限
LT_MEM_LIMIT=2g
LT_CPUS=2
