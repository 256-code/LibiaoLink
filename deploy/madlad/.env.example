# ============================================================
# LibiaoLink MADLAD 翻译服务环境变量样例（cp .env.example .env 后按需改）
# ============================================================

# 镜像名（钉版本；改 Dockerfile 后先 docker compose build）
MADLAD_IMAGE=libiaolink/madlad-translate:1.0.0

# 监听地址与端口（默认只发回环；需要局域网联调时改 MADLAD_BIND_IP=0.0.0.0）
MADLAD_BIND_IP=127.0.0.1
MADLAD_PORT=5006

# 推理参数：beam 越大越慢质量略升（4 = 实测默认）；intra_threads = 单请求内并行线程
MADLAD_BEAM_SIZE=4
MADLAD_INTRA_THREADS=4

# 资源上限（int8 模型常驻约 3-4GB；8g 给推理峰值留余地）
MADLAD_MEM_LIMIT=8g
MADLAD_CPUS=4
