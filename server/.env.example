# 本地开发示例；真实值不落仓库（CONTRIBUTING §12）
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://libiaolink_api@127.0.0.1:5432/libiaolink
LOG_LEVEL=debug

# ---- 认证与会话（/auth/*，ADR-010；g6） ----
# 本地沙箱见 deploy/casdoor/（px 维护）；生产环境 CLIENT_ID / CLIENT_SECRET 必填（启动即校验）
CASDOOR_ISSUER=http://localhost:8000
CASDOOR_CLIENT_ID=
CASDOOR_CLIENT_SECRET=
CASDOOR_REDIRECT_URI=http://localhost:3000/auth/callback
CASDOOR_SCOPE=openid profile email
# 会话空闲超时（分钟；接入标准「企业内部系统」档为 30）
SESSION_IDLE_MINUTES=30
# auto = 仅 production 时给 Cookie 加 Secure
SESSION_COOKIE_SECURE=auto
